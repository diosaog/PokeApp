# Copy this to a local untracked env file before running the real Supabase RLS validator.
# Never commit real values.

POKEAPP_V2_SUPABASE_URL=https://your-project-ref.supabase.co
POKEAPP_V2_SUPABASE_ANON_KEY=your-anon-or-publishable-key
POKEAPP_V2_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. The validator creates temporary Auth users with unique emails.
POKEAPP_V2_TEST_EMAIL_DOMAIN=example.com
